# Copy this file to .env and adjust. Never commit .env.

# Front-end addresses allowed to call the API (JSON list).
APP_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Optional: a pattern matching extra front-end addresses, such as Vercel
# preview links. Leave unset to allow only the list above.
# APP_ALLOWED_ORIGIN_REGEX=https://fall-2026-shipathon-team-5-.*\.vercel\.app

# Largest image accepted, in bytes (default 10 MB).
APP_MAX_IMAGE_BYTES=10485760

# Shortest and longest message accepted by /api/check-text, in characters.
APP_MIN_TEXT_CHARS=20
APP_MAX_TEXT_CHARS=10000

# How many checks one visitor (by IP address) may run, e.g. "10/minute".
APP_RATE_LIMIT=10/minute

# Optional AI-image classifier (see app/services/classifier.py). Leave unset
# to check pictures using only their own data. Set it to a model folder made by
# `python -m evaluation.download_candidate_models`.
# APP_CLASSIFIER_MODEL_DIR=models/vit-distilled
# Scores at or above the high threshold are reported as "likely_ai".
# Placeholders until measured on the test set.
# APP_CLASSIFIER_HIGH_THRESHOLD=0.9
# APP_CLASSIFIER_LOW_THRESHOLD=0.5
