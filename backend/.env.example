# Copy this file to .env and adjust. Never commit .env.

# Front-end addresses allowed to call the API (JSON list).
APP_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Largest image accepted, in bytes (default 10 MB).
APP_MAX_IMAGE_BYTES=10485760

# Shortest and longest message accepted by /api/check-text, in characters.
APP_MIN_TEXT_CHARS=20
APP_MAX_TEXT_CHARS=10000
